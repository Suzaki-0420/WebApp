@model Op03Form
@{
    ViewData["Title"] = "オプション演習-04 タグヘルパーを利用する"; //タイトル
}
<h2>@ViewData["Title"]</h2>
@* 入力された値を出力 *@
<div class="d-flex justify-content-center mt-5">
    <h3>
        @{
            var result = $"答え = {Model.Answer}";
        }
        @result
    </h3>
</div>
@* [戻る]ボタン *@
<div class="d-flex justify-content-center">
    <form method="get">
        <button type="button" onclick="location.href='/Option04/Back'">戻る</button>
    </form>
</div>