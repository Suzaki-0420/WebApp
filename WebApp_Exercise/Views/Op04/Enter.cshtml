@model Op03Form
@{
    ViewData["Title"] = "オプション演習-04 タグヘルパーを利用する";
}
<h2>@ViewData["Title"]</h2>
@*
   使用するコントローラ:TagHelperFormController
   実行するアクションメソッド:Confirm()メソッド
*@
<form asp-controller="Op04" asp-action="Result" method="post">
    @Html.AntiForgeryToken() @* CSRFトークンの生成 *@
    <div class="mb-3">
        <label asp-for="value1" class="form-label"></label>
        <input asp-for="value1" class="form-control" />
        <span asp-validation-for="value1" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="value2" class="form-label"></label>
        <input asp-for="value2" class="form-control" />
        <span asp-validation-for="value2" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="opt" class="form-label"></label>
        <select asp-for="opt" asp-items="Model.OptIDList" class="form-control"></select>
        <span asp-validation-for="opt" class="text-danger"></span>
    </div>

    @* [送信]ボタン *@
    <div class="text-center">
        <button type="submit" class="btn btn-primary">計算</button>
    </div>
</form>