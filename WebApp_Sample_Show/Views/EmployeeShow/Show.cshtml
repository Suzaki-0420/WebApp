@* クラスの名前空間を指定する(C#と同じ) *@
@using WebApp_Sample_Show.Presentations.ViewModels
@* View が受け取るデータ型（ViewModel）を宣言asp-for はこの型のプロパティと結びつける *@
@model List<EmployeeShowViewModel>
@{
    ViewData["Title"] = "従業員一覧";
}
<h2 class="text-center mt-4">@ViewData["Title"]</h2>

<div class="d-flex justify-content-center mt-5">
    <table class="table table-bordered w-auto">
        <thead class="table-light">
            <tr>
                <th>社員ID</th>
                <th>氏名</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var employee in Model)
            {
                <tr>
                    <td>@employee.Id</td>
                    <td>@employee.Name</td>
                </tr>
            }
        </tbody>
    </table>
</div>
@* [戻る]ボタン *@
<div class="d-flex justify-content-center">
    <form method="get">
        <button type="button" onclick="location.href='/'">戻る</button>
    </form>
</div>